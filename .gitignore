venv/
.venv/
env/
ENV/

# =========================
# Model checkpoints outside outputs/
# =========================
*.pt
*.pth
*.ckpt
*.h5
*.keras
*.onnx

# Keep checkpoint files inside the requested outputs folder
!/outputs/**/*.pt
!/outputs/**/*.pth
!/outputs/**/*.ckpt
!/outputs/**/*.h5
!/outputs/**/*.keras
!/outputs/**/*.onnx

# =========================
# Secrets and local settings
# =========================
.env
.env.*
!.env.example

